# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# OpenRouter: set LLM_PROVIDER=openrouter, OPENAI_MODEL=openrouter/free,
# and put your OpenRouter API key in OPENAI_API_KEY.
